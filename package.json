{
  "name": "stockfinder-v2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1",
    "build": "vite build --config apps/web/vite.config.ts && npm run build:worker",
    "build:worker": "esbuild apps/edge-api/src/index.ts --bundle --define:__SF_PG__=true --format=esm --platform=browser --conditions=workerd,worker --external:cloudflare:sockets --external:node:* --outfile=dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:worker && vitest run",
    "db:local": "wrangler d1 migrations apply DB --local",
    "seed:local": "python3 scripts/generate_seed.py && wrangler d1 execute DB --local --file artifacts/seed.sql",
    "deploy": "npm run build && wrangler deploy",
    "test:pg": "bash scripts/test_pg.sh"
  },
  "dependencies": {
    "lucide-react": "^1.66.0",
    "postgres": "^3.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "miniflare": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
